# Babylon Environment Configuration
# Copy to .env and fill in your values

# =============================================================================
# OPERATOR PROVIDER HEALTH (babylon doctor)
# =============================================================================
# Probe an already running OpenAI-compatible endpoint: bundled -> external ->
# Cloudflare (if keyed) -> mute. This does not launch a server, generate text,
# or embed documents. Environment overrides ~/.config/babylon/config.toml.
# `babylon login` stores Cloudflare credentials separately with mode 0600.
# BABYLON_INTEL_MODE=auto            # auto | bundled | external | cloudflare | mute
# BABYLON_INTEL_BUNDLED_URL=http://127.0.0.1:8737/v1
# BABYLON_INTEL_EXTERNAL_URL=http://127.0.0.1:11434/v1
# BABYLON_INTEL_CLOUDFLARE_URL=
# BABYLON_INTEL_CLOUDFLARE_KEY=
# BABYLON_INTEL_TIMEOUT_S=30.0       # health checks cap this at 2 seconds, no retries

# =============================================================================
# DATABASE (SQLite - reference data; spec-061/062/064)
# =============================================================================
DATABASE_URL=sqlite:///babylon.db

# =============================================================================
# POSTGRES (runtime + tests; spec-061/062/064)
# =============================================================================
# Default points at the local docker test container started by
# `mise run db:bootstrap` (creates babylon-pg-isolated on port 5433).
# Override for a different deployment.
#
# T1.2 keel: BABYLON_DSN is now the ONE canonical override — set it and it
# wins for the runner, `babylon doctor`, and both Django database aliases
# (see src/babylon/config/dsn.py for the full precedence order and unix-
# socket DSN support, ADR099). The names below are DEPRECATED per-call-site
# fallbacks, kept for back-compat:
#
# - BABYLON_PG_DSN: the DSN the headless runner reads at runtime
#   (mise run sim:e2e-michigan, python -m babylon.engine.headless_runner).
# - BABYLON_TEST_PG_DSN: fallback DSN for integration tests
#   (tests/integration/test_*.py). Keep identical to BABYLON_PG_DSN for the
#   default dev loop; override in CI if you point at a separate test DB.
# - PGPASSWORD: libpq client convention; matches the DSN password so direct
#   psql inspections work without retyping the password.

BABYLON_PG_DSN=host=localhost port=5433 dbname=babylon_test user=test password=test
BABYLON_TEST_PG_DSN=host=localhost port=5433 dbname=babylon_test user=test password=test
PGPASSWORD=test

# BABYLON_SLOW_TESTS is intentionally NOT set here — it gates the heavyweight
# wallclock-budget + CI clean-run gates (T051, T056) behind explicit opt-in.
# Run those with:
#   BABYLON_SLOW_TESTS=1 mise run test:int

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
DEBUG=false
TESTING=false
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_DIR=./logs

# =============================================================================
# METRICS & PERFORMANCE
# =============================================================================
METRICS_ENABLED=true
METRICS_INTERVAL=60
