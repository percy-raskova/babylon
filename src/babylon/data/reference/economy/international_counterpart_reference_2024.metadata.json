  "edge_decisions": {
    "antarctica": "UN area 010 is nonmarket; no Census code or zero trade is invented.",
    "china_statistical_scope": "China counterpart means mainland statistical scope; Taiwan, Hong Kong and Macao are separate reporting identities in remaining Asia-Pacific.",
    "eu27": "Fixed EU27 override includes Cyprus despite UN Western Asia classification; no automatic overseas dependency inclusion.",
    "freely_associated": "Marshall Islands, Micronesia and Palau are freely associated states, not US dependencies.",
    "iran": "Iran assigned West Asia/North Africa despite UN Southern Asia classification.",
    "kosovo": "UN statistical extension 412 from methodology FAQ; Census reporter KV is not an ISO assignment. Remaining Europe.",
    "palestine": "Keep UN parent 275 for population; Census 5082/5083 are disjoint trade-only leaves assigned West Asia/North Africa, not population units.",
    "remaining_northern_america": "Greenland, Bermuda and Saint Pierre and Miquelon assigned remaining Europe as approved governance/market approximation."
  },
