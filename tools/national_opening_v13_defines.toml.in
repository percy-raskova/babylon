# THE REBUILT NATIONAL OPENING. Schema 8: twelve trades, observed wages, three earning accounts in
# every place. It is written by tools/make_national_opening_numbers.py from the accounts table, the pay
# table and the census of the twelve-trade opening, and is counted on the country bench. It is not yet
# played by the game's own turn: the shipped scenario is content/scenarios/national/defines.toml.
# Every price is millionths of one common currency unit; no exchange rates.
# A marker line stands where the builder writes the numbers it computes; a fact line or a cargo
# line states what the builder reads of the template and is dropped.
schema_version = 8
evidence_class = "Designed"
period_days = 28
work_hours_per_person = 160
opening_pantry_periods = 1
opening_input_periods = 2
working_capital_periods = 2
retailer_buffer_periods = 2
resource_reserve_output_periods = 1040
missing_peer_weight_per_establishment = 1 # Designed allocation points, never observed jobs.
household_enterprise_function = "household_services"

[households]
# Designed exposure within each historical earnings margin; not observed wealth/class.
private_owner_households_bps = 1000
# The next 40% by earnings, the better-paid earning account (rule O17).
next_forty_households_bps = 4000

[markets]
# A domestic buyer's share bought abroad, by product, and the services that cross a border.
#@builder import_bps
#@builder crossing_services
#@builder country_services
# Services a buyer takes only in its own place.
place_services = ["household_services", "housing", "public_provision"]
journey_timing = "slowest_profile" # Administrative hops do not add 28-day delays.
service_reach = "same_state_or_own_counterpart"
# The order of paying (ADR312): what a household buys first, and what last.
#@builder paying_order

[financial]
#@builder financial
cross_border_ownership_bps = 2000

# The country's fund: a share of each tax, place by place where the table below names it (O12, O13).
[fund]
evidence_class = "Designed"
#@builder fund
#@builder share_by_part

#@builder programs

#@builder place_grants

# Designed time accounting. Domestic eligibility uses ACS age 16+ controls;
# external eligibility is a fixed approximation, never a new workforce source.
[household_time]
hours_per_eligible_person = 224
ordinary_protected_hours_per_household = 32
ordinary_provisioning_hours_per_household = 64
collective_protected_hours_per_person = 32
collective_provisioning_hours_per_person = 64
external_eligible_persons_bps = 8000
#@builder unmet_hours

[equipment]
#@builder equipment
installation_hours_per_unit = 32
installation_inputs = { materials = 4 }
installation_workforce_hours_bps = 625
expansion_earnings_fraction_bps = 2500

# Prices change through existing inspectable responsive market policies.
# Public grants pay provider costs; the small posted public fee is separate.

# What the builder reads of the fixture: each product's label, unit label, grams and opening price,
# and its cargo class.
#@fact food | Food for one person for 28 days | person-period food parcel | 14000 | 280000000
#@cargo food | general
#@fact resources | Industrial feedstock | feedstock bundle | 10000 | 40000000
#@cargo resources | dry_bulk
#@fact materials | Manufactured supplies | supplies bundle | 5000 | 120000000
#@cargo materials | general
#@fact equipment | Productive equipment | equipment unit | 250000 | 4000000000
#@cargo equipment | general
#@fact utility | Utility provision | utility service unit | 0 | 75000000
#@fact housing | Housing provision | household-period housing | 0 | 1450000000
#@fact household_services | Household services | person-period service | 0 | 600000000
#@fact business_services | Business support | business service unit | 0 | 100000000
#@fact public_provision | Public provisioning | person-period provision | 0 | 1000000
#@fact consumer_goods | Consumer goods | consumer goods bundle | 5000 | 240000000
#@cargo consumer_goods | general
#@fact leisure | Leisure and hospitality | person-period leisure | 0 | 300000000
#@fact resource_deposit | Finite extractable reserve | feedstock bundle | 10000 | 0

#@builder commodities

#@builder processes

#@builder household_needs

#@builder household_wants

# Counterpart shares are game allocations, not measured class or sector shares.
# Function order (Ord of the twelve trades): business, capital, housing, consumer
# goods, distribution, energy, extraction, food, household services, leisure,
# manufacturing, public. Membership lives separately.

[counterpart."canada"]
participation_bps = 4500
opening_employment_bps = 9000
persons_per_household = 3
wage_fraction_bps = 8333
#@builder region:canada

[counterpart."mexico"]
participation_bps = 4500
opening_employment_bps = 9000
persons_per_household = 3
wage_fraction_bps = 2916
#@builder region:mexico

[counterpart."china"]
participation_bps = 4500
opening_employment_bps = 9000
persons_per_household = 3
wage_fraction_bps = 4166
#@builder region:china

[counterpart."russia"]
participation_bps = 4500
opening_employment_bps = 9000
persons_per_household = 3
wage_fraction_bps = 4583
#@builder region:russia

[counterpart."india"]
participation_bps = 4500
opening_employment_bps = 9000
persons_per_household = 3
wage_fraction_bps = 2083
#@builder region:india

[counterpart."japan"]
participation_bps = 4500
opening_employment_bps = 9000
persons_per_household = 3
wage_fraction_bps = 9166
#@builder region:japan

[counterpart."european_union"]
participation_bps = 4500
opening_employment_bps = 9000
persons_per_household = 3
wage_fraction_bps = 9166
#@builder region:european_union

[counterpart."remaining_europe"]
participation_bps = 4500
opening_employment_bps = 9000
persons_per_household = 3
wage_fraction_bps = 5833
#@builder region:remaining_europe

[counterpart."latin_america_caribbean"]
participation_bps = 4500
opening_employment_bps = 9000
persons_per_household = 3
wage_fraction_bps = 2916
#@builder region:latin_america_caribbean

[counterpart."west_asia_north_africa"]
participation_bps = 4500
opening_employment_bps = 9000
persons_per_household = 3
wage_fraction_bps = 3333
#@builder region:west_asia_north_africa

[counterpart."sub_saharan_africa"]
participation_bps = 4500
opening_employment_bps = 9000
persons_per_household = 3
wage_fraction_bps = 1666
#@builder region:sub_saharan_africa

[counterpart."remaining_asia_pacific"]
participation_bps = 4500
opening_employment_bps = 9000
persons_per_household = 3
wage_fraction_bps = 3750
#@builder region:remaining_asia_pacific

# Separate dependencies use source persons when available. The missing UM
# observation stays missing; its 50 temporary game residents are Designed.
[dependency]
participation_bps = 4500
opening_employment_bps = 9000
persons_per_household = 3
wage_fraction_bps = 10000
#@builder region:dependency
missing_population_game_persons = 50

# Designed terms captured in existing NationalGamePolicy artifact.
[aid]
evidence_class = "Designed"
donor_actor = 2616301
local_recipient_actor = 2616302
remote_recipient_actor = 1703101
donor_contributor_id = 2616301
local_recipient_contributor_id = 2616302
remote_recipient_contributor_id = 1703101
organization_opening_cash_micros = 1000000
maximum_cash_micros = 1450000000
initial_food_quantity = 1
initial_cash_micros = 0
local_cash_receiving_consent = "accept"
remote_cash_receiving_consent = "accept"
fulfillment_hours_per_unit = 2
maximum_quantity = 4

# Designed consent and organization commitments; real time remains finite.
[organizer]
evidence_class = "Designed"
venue_log_reader = "controlled_organizer"
organization_label = "Wayne Organizing Collective"
workplace_partner_label = "Wayne Workplace Committee"
neighborhood_partner_label = "Wayne Neighborhood Contact Group"
local_partner_label = "Wayne Local Aid Partners"
remote_partner_label = "Cook Independent Solidarity Partners"
contributor_hours_cap = 8
inquiry_hours = 2
contact_hours = 2
partner_response_hours = 2
aid_coordination_hours = 2
initial_agreement_through_period = 1
contact_renewal_periods = 1
local_receiving_consent = "accept"
remote_receiving_consent = "accept"
# Independent Designed cash consent; protected material needs remain mandatory.
collection_cash_consent = "accept"
collection_initial_cash_micros = 280000000
collection_maximum_cash_micros = 1450000000
collection_protected_cash_floor_micros = 0
collection_hours = 2
workplace_policy = "participate"
neighborhood_policy = "participate"
local_policy = "participate"
remote_policy = "participate"

[organizer.local_report_sharing]
evidence_class = "Designed"
food = ["food"]
essential_services = ["utility", "housing", "household_services", "public_provision"]
participation_time = true

[organizer.remote_report_sharing]
evidence_class = "Designed"
food = ["food"]
essential_services = ["utility", "housing", "household_services", "public_provision"]
participation_time = true

[grain]
evidence_class = "Designed"
generation = "state_faf_reserve_positions"
protected_counties = ["17031", "26163"]
hub_selection = "largest_observed_population_then_geoid"
access_capacity = "captured_hub_lane"
capacity_refinement = "essential_food_lower_bound_first_fit"

# The food figures that fold the counties into places (O15): the shipped food recipe, need and grams.
[grain.basis]
food_labor_hours_per_batch = 16
food_output_units_per_batch = 16
food_units_per_person = 1
food_grams_per_unit = 14000

[companies]
# Designed opening employment shares. Whole sites can overshoot these targets.
opening_employment_bps = [3500, 3500, 3000]
# Designed share of each subsidiary's spendable cash above its captured operating floor.
opening_treasury_bps = 0
portfolio_weights = [[70, 30, 0, 0], [10, 70, 15, 5], [60, 25, 15, 0], [10, 10, 60, 20]]
high_utilization_bps = 8000
history_periods = 3
modest_expansion_bps = 5000
# Existing national-world-v7 physical geography namespace. Company policy retains its own full source digest.
inherited_grain_policy_sha256 = [0xa4, 0x33, 0x05, 0xed, 0x1d, 0x0e, 0x95, 0xf9, 0xd7, 0xdf, 0x6b, 0x8a, 0xac, 0xe5, 0xa8, 0xf9, 0x79, 0x08, 0x26, 0xf8, 0xc4, 0xc0, 0xb3, 0xb0, 0x6d, 0x1d, 0x54, 0x67, 0x51, 0xdc, 0x4f, 0x03]

[household_lifecycle]
# Designed initial birthdays fill the remaining four-week periods of each age band.
# Survivors finish the band within its full width. Subsequent entrants keep their due period.
initial_age_distribution = "uniform_remaining_birthdays"
# Designed common four-week gameplay rates, per million residents in the specified
# opening band. Birth exposure is residents age 18–64. Death exposures follow
# under 16, 16–17, 18–64 and 65+. These terms are shared across all markets.
births_per_million_working_age_per_period = 1350
deaths_per_million_per_period = [15, 20, 340, 3250]
# Designed foreign/dependency mix within the pre-existing 16+ control, in the
# order 16–17, 18–64 and 65+. Domestic county ages use the captured ACS margins.
external_eligible_age_bps = [400, 8000, 1600]

# Separate no-earner nonowner households drawn from Wayne's reserve residents.
[household_support_claimant]
evidence_class = "Designed"
county = "26163"
households = 2
reserve_persons = 2

# The two household bodies separately authorize their delegations for this hearing.
# The minutes grant a place at the next review. They cannot spend county money.
[organizer.hearing]
evidence_class = "Designed"
county_geoid = "26163"
period = 2
review_period = 3
attendance_hours = 2
claimant_label = "Wayne Relief Claimants Assembly"
claimant_claim = "Keep current claimants on the relief roll while the county reviews their cases."
partner_claim = "Hear the cases of residents who received no county support."
claimant_mandate = "either_procedural_offer"
partner_mandate = { settle = "joint_minutes" }
claimant_delegation = { delegate_label = "Claimants' meeting secretary", authorizing_households = 2 }
partner_delegation = { delegate_label = "Case delegate for the aid partners", authorizing_households = 3 }

# The City PD's books. The force is already employed inside Wayne's public workplaces, so
# its payroll is named there (positions x a period's hours x the wage) and not paid twice.
# The appropriation pays for the visits allowed in a period at the price of a visit hour.
[city_pd]
evidence_class = "Designed"
positions = 3529
positions_source = "City of Detroit, City Council Legislative Policy Division, budget analysis of 21 March 2025: Police Department, adopted positions, fiscal year 2025"
visits_per_period = 1
visit_hours = 1

# The county review. The county ranks its households by the wage tax each paid and pays relief
# units down that list; the organizer can reach one household in a named position per period. The
# price of a unit is derived from the opening, not written here. The two body labels repeat the
# labels the hearing already uses and are checked against them.
[county_review]
evidence_class = "Designed"
county = "26163"
first_session_period = 4
session_hours = 2
bring_hours = 2
administration_label = "Wayne County administration"
claimants_body_label = "Wayne Relief Claimants Assembly"
aid_body_label = "Wayne Local Aid Partners"

# Luxury scales: an account whose money passes its three tiers buys its luxuries again (call 20).
#@builder luxury_scale
